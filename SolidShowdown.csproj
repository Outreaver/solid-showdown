<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The example files are compiled (so the demos really run) AND embedded,
         so the UI can show you the exact source that produced the output. -->
    <EmbeddedResource Include="Examples\**\*.cs" LogicalName="Examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
